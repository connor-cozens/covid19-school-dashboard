# .env.example — copy to .env.production (production) or .env.development (dev/staging)
#
# These files are gitignored. This example file is the only one committed.
# Next.js loads the appropriate file automatically based on NODE_ENV.
# The deploy script reads the same files — no separate config needed.
#
# Setup:
#   cp .env.example .env.production    # fill in production GCP project
#   cp .env.example .env.development   # fill in dev/staging GCP project

# ── Deployment (used by scripts/setup/deploy.sh) ───────────────────────────────

# Google Cloud project ID (required for npm run deploy)
PROJECT_ID=your-gcp-project-id

# Cloud Run region (optional — default: us-central1)
# Canadian option: northamerica-northeast1 (Montréal)
# REGION=us-central1

# Cloud Run service name (optional — default: covid-dashboard)
# SERVICE_NAME=covid-dashboard

# ── Next.js public runtime variables ──────────────────────────────────────────
# Add NEXT_PUBLIC_* variables here as needed (e.g. analytics, feature flags).
# These are inlined at build time and visible in the browser.

# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
