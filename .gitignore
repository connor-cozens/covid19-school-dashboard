# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# R Studio session files
.RData
.Rhistory
.Rproj.user/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# School closures data — never check in. The source spreadsheet lives in the private
# covid19-school-dashboard-data repo; locally it goes in private-data/ (outside public/,
# so it can never be published with the site). school_closures.json is generated from it.
/private-data/
public/data/school_closures.json
public/data/*.xlsx
public/data/closure_corrections_log.json
public/data/*.numbers

# playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
